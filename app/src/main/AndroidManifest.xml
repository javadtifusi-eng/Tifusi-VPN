<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Samsung, Xiaomi and similar phones otherwise kill the VPN once the app leaves the screen. -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <!-- Only for scanning the panel's subscription QR codes. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />

    <application
        android:name=".TifusiVpnApp"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:localeConfig="@xml/locales_config"
        android:supportsRtl="true"
        android:theme="@style/Theme.TifusiVpn">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:theme="@style/Theme.TifusiVpn">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Lets AppCompat persist the in-app language choice on Android versions before 13. -->
        <service
            android:name="androidx.appcompat.app.AppLocalesMetadataHolderService"
            android:enabled="false"
            android:exported="false">
            <meta-data
                android:name="autoStoreLocales"
                android:value="true" />
        </service>

        <!-- The system starts this with the platform IKEv2 VPN's error reports (Android 13+). -->
        <service
            android:name=".vpn.VpnEventService"
            android:exported="true">
            <intent-filter>
                <action android:name="android.net.action.VPN_MANAGER_EVENT" />
                <category android:name="android.net.category.EVENT_IKE_ERROR" />
                <category android:name="android.net.category.EVENT_NETWORK_ERROR" />
                <category android:name="android.net.category.EVENT_DEACTIVATED_BY_USER" />
                <category android:name="android.net.category.EVENT_ALWAYS_ON_STATE_CHANGED" />
            </intent-filter>
        </service>

        <!-- VLESS through the embedded Xray core. specialUse is what v2rayNG declares for the same
             kind of service; Android 14 requires a foreground service type. -->
        <service
            android:name=".vpn.XrayVpnService"
            android:exported="false"
            android:foregroundServiceType="specialUse"
            android:permission="android.permission.BIND_VPN_SERVICE">
            <intent-filter>
                <action android:name="android.net.VpnService" />
            </intent-filter>
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="vpn" />
        </service>

    </application>

</manifest>
