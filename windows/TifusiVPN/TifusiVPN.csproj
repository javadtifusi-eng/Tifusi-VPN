<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Lets CI and local checks build the WPF app on Linux too; it still only runs on Windows. -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <AssemblyName>TifusiVPN</AssemblyName>
    <RootNamespace>TifusiVpn</RootNamespace>

    <!-- CI passes its run number, the same number the Android build and the release tag use. -->
    <TifusiBuildNumber Condition="'$(TifusiBuildNumber)' == ''">1</TifusiBuildNumber>
    <Version>1.0.$(TifusiBuildNumber)</Version>

    <!-- One .exe with the .NET runtime inside, so users need nothing installed. -->
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
  </PropertyGroup>

</Project>
