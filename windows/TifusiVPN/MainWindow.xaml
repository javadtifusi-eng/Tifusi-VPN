<Window x:Class="TifusiVpn.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Tifusi VPN" Width="430" Height="820" MinWidth="380" MinHeight="660"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgBrush}" Foreground="White" FontFamily="Segoe UI" FontSize="14">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Tifusi VPN" FontSize="24" FontWeight="SemiBold" Margin="22,18,22,8" />

        <Grid Grid.Row="1">
            <!-- Home -->
            <ScrollViewer x:Name="HomePanel" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="16,8,16,16">
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Ellipse x:Name="StatusDot" Width="10" Height="10" Fill="{StaticResource MutedBrush}"
                                         VerticalAlignment="Center" />
                                <StackPanel Grid.Column="1" Margin="10,0">
                                    <TextBlock x:Name="StatusText" FontSize="17" FontWeight="SemiBold" />
                                    <TextBlock x:Name="DurationText" Foreground="{StaticResource MutedBrush}" Text="00:00:00" />
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock x:Name="ServerNameText" FontSize="16" FontWeight="SemiBold" TextAlignment="Right" />
                                    <TextBlock x:Name="ServerAddressText" Foreground="{StaticResource MutedBrush}" TextAlignment="Right" />
                                </StackPanel>
                            </Grid>
                            <Border Height="1" Background="{StaticResource EdgeBrush}" Margin="0,12" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition />
                                    <ColumnDefinition />
                                    <ColumnDefinition />
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="DownText" Text="↓  —" />
                                <TextBlock x:Name="UpText" Grid.Column="1" Text="↑  —" HorizontalAlignment="Center" />
                                <TextBlock x:Name="PingText" Grid.Column="2" Text="—" HorizontalAlignment="Right" />
                            </Grid>
                            <TextBlock x:Name="QuotaText" Foreground="{StaticResource MutedBrush}" Margin="0,12,0,0"
                                       TextWrapping="Wrap" Visibility="Collapsed" />
                        </StackPanel>
                    </Border>

                    <Button x:Name="PowerButton" Click="PowerButton_Click" Width="200" Height="200" Margin="0,34,0,10"
                            Cursor="Hand" BorderBrush="#3A4470">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Grid>
                                    <Ellipse Fill="#141B36" />
                                    <Ellipse Stroke="{TemplateBinding BorderBrush}" StrokeThickness="7" Margin="4" />
                                    <TextBlock Text="&#xE7E8;" FontFamily="Segoe MDL2 Assets" FontSize="64" Foreground="White"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Grid>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                    <TextBlock x:Name="PowerLabel" HorizontalAlignment="Center" FontSize="18" FontWeight="SemiBold" />
                    <TextBlock x:Name="ErrorText" Foreground="{StaticResource ErrorBrush}" TextWrapping="Wrap"
                               Margin="4,18,4,0" Visibility="Collapsed" />
                </StackPanel>
            </ScrollViewer>

            <!-- Servers -->
            <ScrollViewer x:Name="ServersPanel" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                <StackPanel Margin="16,8,16,16">
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock x:Name="SubTitle" FontSize="16" FontWeight="SemiBold" />
                            <TextBox x:Name="SubInput" Style="{StaticResource DarkTextBox}" Margin="0,10,0,0" FlowDirection="LeftToRight" />
                            <Grid Margin="0,12,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition />
                                    <ColumnDefinition Width="10" />
                                    <ColumnDefinition />
                                </Grid.ColumnDefinitions>
                                <Button x:Name="GetServersButton" Style="{StaticResource PrimaryButton}" Click="GetServers_Click" />
                                <Button x:Name="RefreshButton" Grid.Column="2" Style="{StaticResource OutlineButton}" Click="Refresh_Click" />
                            </Grid>
                            <TextBlock x:Name="SubMessage" TextWrapping="Wrap" Margin="0,12,0,0" Visibility="Collapsed" />
                        </StackPanel>
                    </Border>
                    <TextBlock x:Name="NoServersText" Foreground="{StaticResource MutedBrush}" Margin="4,16" TextWrapping="Wrap" />
                    <ItemsControl x:Name="ServerList" Margin="0,4,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Click="Server_Click" Tag="{Binding Id}" Margin="0,0,0,10" Cursor="Hand">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="#141B36" BorderBrush="{Binding BorderColor}" BorderThickness="1.5"
                                                    CornerRadius="16" Padding="16,12">
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Name}" FontSize="16" FontWeight="SemiBold" Foreground="White" />
                                                    <TextBlock Text="{Binding Subtitle}" Foreground="#8A93B8" />
                                                </StackPanel>
                                            </Border>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>

            <!-- Profile -->
            <ScrollViewer x:Name="ProfilePanel" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                <StackPanel Margin="20,8,20,16">
                    <TextBlock x:Name="LanguageTitle" FontSize="22" FontWeight="SemiBold" Margin="0,0,0,8" />
                    <RadioButton x:Name="LangEn" Content="English" Foreground="White" FontSize="15" Margin="0,8"
                                 GroupName="Lang" Checked="Language_Checked" Tag="en" />
                    <RadioButton x:Name="LangFa" Content="فارسی" Foreground="White" FontSize="15" Margin="0,8"
                                 GroupName="Lang" Checked="Language_Checked" Tag="fa" />
                    <TextBlock x:Name="ContactTitle" FontSize="22" FontWeight="SemiBold" Margin="0,24,0,10" />
                    <Button x:Name="TelegramButton" Style="{StaticResource OutlineButton}" Click="Telegram_Click" />
                </StackPanel>
            </ScrollViewer>

            <!-- About -->
            <ScrollViewer x:Name="AboutPanel" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                <StackPanel Margin="16,8,16,16">
                    <TextBlock x:Name="AboutTitle" FontSize="22" FontWeight="SemiBold" Margin="4,0,0,12" />
                    <Border Style="{StaticResource Card}" Margin="0,0,0,10">
                        <TextBlock x:Name="VersionText" FontSize="15" />
                    </Border>
                    <Border Style="{StaticResource Card}" Margin="0,0,0,10">
                        <TextBlock x:Name="UpdateText" FontSize="15" TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" />
                    </Border>
                    <Button x:Name="DownloadUpdateButton" Style="{StaticResource PrimaryButton}" Click="DownloadUpdate_Click"
                            Margin="0,0,0,10" Visibility="Collapsed" />
                    <Button x:Name="CheckUpdateButton" Style="{StaticResource OutlineButton}" Click="CheckUpdate_Click" Margin="0,0,0,10" />
                    <Border Style="{StaticResource Card}">
                        <TextBlock x:Name="WindowsVersionText" FontSize="15" />
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <Border Grid.Row="2" Background="{StaticResource SurfaceBrush}">
            <UniformGrid Columns="4">
                <RadioButton x:Name="TabHome" Style="{StaticResource NavButton}" GroupName="Nav" Tag="&#xE80F;"
                             IsChecked="True" Checked="Tab_Checked" />
                <RadioButton x:Name="TabServers" Style="{StaticResource NavButton}" GroupName="Nav" Tag="&#xE968;"
                             Checked="Tab_Checked" />
                <RadioButton x:Name="TabProfile" Style="{StaticResource NavButton}" GroupName="Nav" Tag="&#xE77B;"
                             Checked="Tab_Checked" />
                <RadioButton x:Name="TabAbout" Style="{StaticResource NavButton}" GroupName="Nav" Tag="&#xE7C3;"
                             Checked="Tab_Checked" />
            </UniformGrid>
        </Border>
    </Grid>
</Window>
