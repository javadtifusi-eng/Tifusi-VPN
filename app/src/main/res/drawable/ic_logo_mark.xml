<?xml version="1.0" encoding="utf-8"?>
<!-- The same mark as ic_logo_shield, but with the viewport cropped to the artwork so it fills
     whatever size it is drawn at. ic_logo_shield keeps the 108dp adaptive-icon canvas because the
     launcher foreground and the notification icon need that padding; Compose needs this one. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="40dp"
    android:height="34dp"
    android:viewportWidth="40"
    android:viewportHeight="34">

    <path
        android:fillColor="#0A0F24"
        android:strokeColor="#2979FF"
        android:strokeWidth="2.5"
        android:strokeLineJoin="round"
        android:pathData="M20,2 L34,6 L34,16 C34,25 28,29 20,32 C12,29 6,25 6,16 L6,6 Z" />

    <path
        android:fillColor="#FFFFFF"
        android:pathData="M13,10 L27,10 L26,14 L22,14 L22,27 L18,27 L18,14 L13,14 Z" />

    <path
        android:fillColor="#00000000"
        android:strokeColor="#29B6F6"
        android:strokeWidth="1.8"
        android:strokeLineCap="round"
        android:pathData="M2,25 C10,17 28,13 38,15" />
</vector>
